# Environment Variables for PingMe
# Copy this file to .env.local and customize for your environment

# App Configuration
VITE_APP_NAME=PingMe
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_SOUND_ENABLED=true
VITE_SHARE_ENABLED=true
VITE_TIME_REMINDERS_ENABLED=true

# Limits
VITE_MAX_REMINDERS=100

# External Services (for future use)
# VITE_API_BASE_URL=https://api.pingme.example.com
# VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org